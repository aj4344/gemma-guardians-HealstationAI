# ═══════════════════════════════════════════════════════════
# HealStation AI — Environment Configuration
# Copy this file to .env before running. Every setting is optional;
# the values below are the defaults. Real environment variables take
# precedence over this file. All settings are read in config.py.
# ═══════════════════════════════════════════════════════════

# ── Ollama / Gemma 4 (must be running locally) ───────────────
OLLAMA_BASE_URL=http://localhost:11434

# Model selection:
# gemma4:e2b    — Recommended (best clinical accuracy, needs 6GB+ VRAM)
# gemma2:2b     — For lower-spec hardware (<6GB VRAM, slower but works)
OLLAMA_MODEL=gemma4:e2b

# Triage call tuning
LOCAL_GEMMA_TIMEOUT_SECONDS=120
LOCAL_GEMMA_NUM_CTX=1024
LOCAL_GEMMA_NUM_PREDICT=1400
LOCAL_TRIAGE_CONFIDENCE_THRESHOLD=0.6   # below this, the rules-based classifier is used
ENABLE_LOCAL_TRIAGE=true

# ── Server ───────────────────────────────────────────────────
API_HOST=127.0.0.1     # use 0.0.0.0 only behind a firewall / reverse proxy
API_PORT=8001
# Browser origins allowed to call the API (comma-separated). Not needed when
# the API serves the built UI itself (same origin).
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_REQUEST_MB=60

# ── Speech-to-Text (faster-whisper) ──────────────────────────
ENABLE_LOCAL_STT=true
LOCAL_STT_MODEL_SIZE=small   # tiny | small | medium (smaller = faster)
LOCAL_STT_DEVICE=cpu         # cpu | cuda
LOCAL_STT_COMPUTE_TYPE=int8  # int8 for CPU, float16 for GPU
LOCAL_STT_LOCAL_FILES_ONLY=true   # set false once to download the model
MAX_AUDIO_UPLOAD_MB=25

# ── Text-to-Speech (pyttsx3) ─────────────────────────────────
LOCAL_TTS_ENABLED=true
# Generated recordings contain health information; they are deleted after this.
AUDIO_RETENTION_SECONDS=3600
